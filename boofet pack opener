document.head.appendChild(style);

// ===== NORMAL RARITY LOGIC =====
function rollPack() {
  const r = Math.random();
  if (r < 0.001) return { name: "Legendary", color: "#facc15" };
  if (r < 0.01)  return { name: "Chroma",     color: "#22d3ee" };
  if (r < 0.05)  return { name: "Epic",       color: "#a855f7" };
  if (r < 0.25)  return { name: "Rare",       color: "#3b82f6" };
  return           { name: "Uncommon",        color: "#22c55e" };
}

// ===== FOOTER =====
const footer = document.createElement("div");
footer.style = "margin-top:10px;opacity:0.8;font-size:12px;";
footer.innerHTML = `<hr>Thanks for using my opener<br>- PrimeAndrew / PrimeAugust`;
panel.appendChild(footer);

// ===== INFINITE PACK OPENER =====
let packCount = 0;

function openInfinitePacks(batchSize = 5, delay = 200) {
  setInterval(() => {
    for (let i = 0; i < batchSize; i++) {
      packCount++;
      const pull = rollPack();

      const line = document.createElement("div");
      line.style.color = pull.color;
      line.textContent = `#${packCount} → ${pull.name}`;
      
      // Insert line **before the footer** so footer stays at bottom
      panel.insertBefore(line, footer);

      // Scroll panel to bottom
      panel.scrollTop = panel.scrollHeight;
    }
  }, delay);
}

//START INFINITE PACK OPENING
openInfinitePacks(5, 1500);
