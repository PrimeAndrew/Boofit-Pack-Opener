// ===== INFINITE PACK OPENER WITH AGGREGATION =====
const packCounts = {}; // track counts for each pull
function openInfinitePacks(packName, batchSize = 10, delay = 200) {
  const normalized = packName.trim();
  if (!normalized) return;

  setInterval(() => {
    for (let i = 0; i < batchSize; i++) {
      const pull = rollPack();
      const key = pull.name;

      // increase count
      packCounts[key] = (packCounts[key] || 0) + 1;

      // if line already exists, update it; otherwise, create it
      let line = panel.querySelector(`[data-pull="${key}"]`);
      if (!line) {
        line = document.createElement("div");
        line.style.color = pull.color;
        line.dataset.pull = key;
        line.textContent = `${key} x1`;
        panel.insertBefore(line, footer);
      } else {
        let count = packCounts[key];
        // show in k if large enough
        if (count >= 1000) {
          const kCount = Math.floor(count / 1000);
          line.textContent = `${key} x${kCount}k`;
        } else {
          line.textContent = `${key} x${count}`;
        }
      }
    }

    // scroll panel
    panel.scrollTop = panel.scrollHeight;
  }, delay);
}

//ASK USER FOR PACK
const chosenPack = prompt("Which pack do you want to open?").trim();
if (chosenPack) openInfinitePacks(chosenPack);
