// ===== INPUT FOR CUSTOM PACK =====
const inputContainer = document.createElement("div");
inputContainer.style = "margin-bottom:10px;";
inputContainer.innerHTML = `
  <input id="packInput" placeholder="Type pack name (not case-sensitive)" style="width: 70%; padding: 4px; border-radius: 6px; border:none; font-family: monospace;" />
  <button id="packButton" style="padding:4px 6px; border-radius:6px; border:none; cursor:pointer;">Pull</button>
`;
panel.insertBefore(inputContainer, footer);

const packInput = document.getElementById("packInput");
const packButton = document.getElementById("packButton");

// ===== PACK OPENING LOGIC WITH STACKING =====
let packCount = 0;
const packLines = {}; // track lines for each pack

function rollPack(customPack) {
  if (customPack) {
    const key = customPack.toLowerCase();
    if (packs[key]) return { name: key.charAt(0).toUpperCase() + key.slice(1), color: packs[key] };
  }
  const r = Math.random();
  if (r < 0.001) return { name: "Legendary", color: packs.legendary };
  if (r < 0.01)  return { name: "Chroma", color: packs.chroma };
  if (r < 0.05)  return { name: "Epic", color: packs.epic };
  if (r < 0.25)  return { name: "Rare", color: packs.rare };
  return { name: "Uncommon", color: packs.uncommon };
}

function addPackLine(pull) {
  packCount++;
  const packName = pull.name;

  if (packLines[packName]) {
    // Already exists, increment count
    packLines[packName].count++;
    packLines[packName].line.innerHTML = `<b>#${packCount - packLines[packName].count + 1} → ${packName} ${packLines[packName].count}x</b>`;
  } else {
    // New line
    const line = document.createElement("div");
    line.style.color = pull.color;
    line.innerHTML = `<b>#${packCount} → ${packName}</b>`;
    panel.insertBefore(line, footer);
    packLines[packName] = { line, count: 1 };
  }

  panel.scrollTop = panel.scrollHeight;
}

// ===== SUPER FAST PACK OPENING =====
function openInfinitePacks(customPack = null) {
  function loop() {
    const pull = rollPack(customPack);
    addPackLine(pull);
    setTimeout(loop, 1); // 1ms delay, almost instant
  }
  loop();
}

// ===== BUTTON EVENT =====
packButton.addEventListener("click", () => {
  const packName = packInput.value.trim();
  if (!packName) {
    openInfinitePacks(); // random if blank
  } else {
    openInfinitePacks(packName); // chosen pack, not case-sensitive
  }
});
